# Copy this file to the PROJECT ROOT as ".env" (not committed to git):
#   copy config\.env.example .env     (Windows)
#   cp config/.env.example .env       (Linux/macOS)
#
# GitHub Secrets (BALE_BOT_TOKEN, ...) are ONLY available inside GitHub Actions.
# On your PC you must use this .env file or set environment variables manually.

DJANGO_SECRET_KEY=dev-secret-change-me
USE_SQLITE=1
DEBUG=1

# Bale bot (from @BotFather in Bale)
BALE_BOT_TOKEN=your_bale_bot_token_here
BALE_CARD_NUMBER=
BALE_API_URL=https://tapi.bale.ai

# MySQL (only if USE_SQLITE=0)
# DB_NAME=bale_db
# DB_USER=bale_user
# DB_PASSWORD=changeme
# DB_HOST=localhost
# DB_PORT=3306
