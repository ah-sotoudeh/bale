# Copy to project root as ".env"

DJANGO_SECRET_KEY=dev-secret-change-me
USE_SQLITE=1
DEBUG=1

# بازوی گفتگو با مشتری/مدیر (پنل سفارش)
BALE_BOT_TOKEN=your_conversation_bot_token_here

# بازوی لینک‌یار — ارسال و حذف بنر در کانال‌ها
# اگر خالی باشد همان BALE_BOT_TOKEN استفاده می‌شود
LINKYAR_BOT_TOKEN=
# نام نمایشی برای پیام به مدیران
LINKYAR_USERNAME=@linkyar

BALE_CARD_NUMBER=
BALE_API_URL=https://tapi.bale.ai

REFERENCE_CHANNEL=@linktest
OPERATOR_BALE_ID=
PLATFORM_FEE_PERCENT=14
MIN_PAYOUT_TOMAN=100000
