# Copy to project root as ".env"

DJANGO_SECRET_KEY=dev-secret-change-me
USE_SQLITE=1
DEBUG=1

# بازوی گفتگو = لینک‌سازه (Bot API)
BALE_BOT_TOKEN=your_link_sazeh_bot_token

# لینک‌یار = حساب کاربری شخصی (سشن JWT از web.bale.ai) — نه توکن بازو
# همان BALE_TOKEN ریپوی bale-ai
BALE_TOKEN=your_user_session_jwt_here
LINKYAR_USERNAME=@linkyar

BALE_CARD_NUMBER=
BALE_API_URL=https://tapi.bale.ai

REFERENCE_CHANNEL=@linktest
OPERATOR_BALE_ID=
PLATFORM_FEE_PERCENT=14
MIN_PAYOUT_TOMAN=100000
